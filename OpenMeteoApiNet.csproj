<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>A C# Interface For The Open-Meteo API.</Description>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>OpenMeteoApiNet</PackageId>
		<Version>1.0.1</Version>
		<Authors>Eric J. Drewitz</Authors>
		<Product>OpenMeteoApiNet</Product>
		<RepositoryUrl>https://github.com/edrewitz/OpenMeteoApi.NET</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReleaseNotes>
			Fixed bugs related to invalid variable names. 
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Data.Analysis" Version="0.23.0" />
	</ItemGroup>

</Project>
